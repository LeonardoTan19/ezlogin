# Android SDK paths — adjust to match your local installation
ANDROID_HOME=/path/to/Android/Sdk
ANDROID_SDK_ROOT=/path/to/Android/Sdk
ANDROID_NDK_HOME=/path/to/Android/Sdk/ndk
NDK_HOME=/path/to/Android/Sdk/ndk

# Android release signing
TAURI_ANDROID_KEYSTORE_PATH=/path/to/release.jks
TAURI_ANDROID_KEYSTORE_PASSWORD=your_keystore_password
TAURI_ANDROID_KEY_ALIAS=your_key_alias
TAURI_ANDROID_KEY_PASSWORD=your_key_password
